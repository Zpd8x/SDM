{
  "manifest_version": 3,
  "name": "SDM Integration",
  "version": "2.0.0",
  "description": "Browser Integration & Capture Engine 2.0 with batch queue, persistent native messaging, media inspection, and download interception.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media_overlay.js"
      ],
      "css": [
        "media_overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to SDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "version_name": "2.0.0 Final"
}